FROM rust:1.85.1-bookworm

RUN cargo install just --locked --version 1.40.0

WORKDIR /workspace
COPY . .

RUN just bootstrap \
    && just format-check \
    && just lint \
    && just build \
    && just test-fast \
    && just validate \
    && just license-check \
    && just mcp-smoke \
    && just capability-report \
    && just sbom

ENTRYPOINT ["cargo", "run", "--locked", "--quiet", "--bin", "icstudio", "--"]
CMD ["truth"]
