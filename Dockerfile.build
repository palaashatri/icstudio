# Reproducible Java factory: Eclipse Temurin 25.0.4+7, the Maven Wrapper, and a non-root runtime user.
FROM eclipse-temurin:25.0.4_7-jdk-noble

# Skia (via Skija) links against EGL and GL at load time; the factory runs the Swing/Skia tests.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libegl1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

RUN ./mvnw -B -ntp verify \
    && ./mvnw -B -ntp -pl java/icstudio-conformance test -Dtest=SbomLicencePolicyTest -Dsurefire.failIfNoSpecifiedTests=false \
    && useradd --create-home --uid 10001 icstudio \
    && chown -R icstudio:icstudio /workspace

USER icstudio

# The CLI has no third-party runtime dependencies; it runs from the reactor's compiled classes.
ENTRYPOINT ["java", "-cp", "/workspace/java/icstudio-core/target/classes:/workspace/java/icstudio-project/target/classes:/workspace/java/icstudio-command/target/classes:/workspace/java/icstudio-platform/target/classes:/workspace/java/icstudio-cli/target/classes", "dev.icstudio.cli.IcStudioCli"]
CMD ["truth"]
