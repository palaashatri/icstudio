{
  "name": "@icstudio/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.main.json && vite build",
    "test": "node --test tests/*.test.mjs",
    "license-check": "node scripts/dependency-evidence.mjs --check-only",
    "sbom": "node scripts/dependency-evidence.mjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "electron": "35.0.0",
    "typescript": "5.7.2",
    "vite": "6.1.0"
  }
}
